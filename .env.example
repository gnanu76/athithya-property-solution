# Copy this file to ".env" (same folder as index.html) and fill in real values.
# NEVER commit the real .env file or share these values.

PORT=3000

# Where enquiries are delivered
ENQUIRY_TO=athithyapropertyconsultant@gmail.com

# SMTP settings (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# The Gmail account that SENDS the email
SMTP_USER=your-sending-account@gmail.com
# A Google "App Password" (needs 2-Step Verification), NOT your normal password
SMTP_PASS=your-16-character-app-password
